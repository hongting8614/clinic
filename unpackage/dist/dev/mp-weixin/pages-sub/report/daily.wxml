<view class="daily-report-page data-v-4d34a038"><view class="report-container data-v-4d34a038"><view class="report-card data-v-4d34a038"><view class="report-header data-v-4d34a038"><view class="header-left data-v-4d34a038"><text class="report-date data-v-4d34a038">{{reportDate}}</text><text class="report-location data-v-4d34a038">{{reportLocation}}</text></view><view class="header-actions data-v-4d34a038"><view data-event-opts="{{[['tap',[['editReportText',['$event']]]]]}}" class="action-btn edit-btn data-v-4d34a038" bindtap="__e"><text class="action-icon data-v-4d34a038">{{isEditingText?'✓':'✏️'}}</text><text class="action-label data-v-4d34a038">{{isEditingText?'完成':'编辑'}}</text></view><view data-event-opts="{{[['tap',[['copyReport',['$event']]]]]}}" class="action-btn copy-btn data-v-4d34a038" bindtap="__e"><text class="action-icon data-v-4d34a038">📋</text><text class="action-label data-v-4d34a038">复制</text></view></view></view><view class="report-content data-v-4d34a038"><block wx:if="{{isEditingText}}"><textarea class="report-textarea data-v-4d34a038" placeholder="请输入日报内容" auto-height="{{true}}" data-event-opts="{{[['input',[['__set_model',['','reportContent','$event',[]]]]]]}}" value="{{reportContent}}" bindinput="__e"></textarea></block><block wx:else><text class="report-text data-v-4d34a038" selectable="{{true}}">{{reportContent}}</text></block></view></view><block wx:if="{{stats}}"><view class="stats-card data-v-4d34a038"><view class="stats-title data-v-4d34a038">统计信息</view><view class="stats-grid data-v-4d34a038"><view class="stat-item data-v-4d34a038"><text class="stat-value data-v-4d34a038">{{stats.total}}</text><text class="stat-label data-v-4d34a038">总接诊</text></view><view class="stat-item data-v-4d34a038"><text class="stat-value data-v-4d34a038">{{stats.visitorTotal}}</text><text class="stat-label data-v-4d34a038">游客</text></view><view class="stat-item data-v-4d34a038"><text class="stat-value data-v-4d34a038">{{stats.employeeTotal}}</text><text class="stat-label data-v-4d34a038">员工</text></view><view class="stat-item data-v-4d34a038"><text class="stat-value data-v-4d34a038">{{stats.outcallTotal}}</text><text class="stat-label data-v-4d34a038">出诊次数</text></view></view></view></block></view><view class="bottom-actions data-v-4d34a038"><button data-event-opts="{{[['tap',[['goClinic',['$event']]]]]}}" class="action-button secondary data-v-4d34a038" bindtap="__e">门诊登记</button><button data-event-opts="{{[['tap',[['copyVisitorReport',['$event']]]]]}}" class="action-button primary data-v-4d34a038" bindtap="__e">复制游客</button><button data-event-opts="{{[['tap',[['copyEmployeeReport',['$event']]]]]}}" class="action-button primary data-v-4d34a038" bindtap="__e">复制员工</button></view></view>