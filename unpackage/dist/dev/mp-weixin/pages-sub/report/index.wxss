/* 快捷操作区 */
.quick-section.data-v-1ea813c6 {
	max-width: 702rpx;
	margin: 0 auto 16rpx;
	padding: 20rpx 24rpx 24rpx;
	background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
	border-radius: 22rpx;
	box-shadow: 0 8rpx 20rpx rgba(234, 179, 8, 0.25);
	border: 2rpx solid #fbbf24;
}
.quick-grid.data-v-1ea813c6 {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 16rpx;
}
.quick-item.data-v-1ea813c6 {
	background: #ffffff;
	border-radius: 16rpx;
	padding: 24rpx 20rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	text-align: center;
	box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.1);
	transition: -webkit-transform 0.2s;
	transition: transform 0.2s;
	transition: transform 0.2s, -webkit-transform 0.2s;
	position: relative;
}
.quick-item.data-v-1ea813c6:active {
	-webkit-transform: scale(0.97);
	        transform: scale(0.97);
}
.quick-icon.data-v-1ea813c6 {
	width: 68rpx;
	height: 68rpx;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 36rpx;
	margin-bottom: 12rpx;
	background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
	box-shadow: 0 4rpx 12rpx rgba(234, 179, 8, 0.2);
}
.quick-title.data-v-1ea813c6 {
	font-size: 28rpx;
	font-weight: 600;
	color: #111827;
	margin-bottom: 8rpx;
}
.quick-badge.data-v-1ea813c6 {
	position: absolute;
	top: 12rpx;
	right: 12rpx;
	padding: 4rpx 12rpx;
	background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
	color: #ffffff;
	font-size: 20rpx;
	font-weight: 600;
	border-radius: 12rpx;
	box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.3);
}

