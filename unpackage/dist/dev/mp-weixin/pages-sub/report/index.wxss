
.page.data-v-1ea813c6 {
	min-height: 100vh;
	background: linear-gradient(180deg, #00c9ff 0%, #00a0ff 35%, #e5e7eb 100%);
	padding-bottom: 40rpx;
}
.page-header.data-v-1ea813c6 {
	max-width: 702rpx;
	margin: 24rpx auto 16rpx;
	padding: 32rpx 30rpx 26rpx;
	background: #FFFFF0;
	border-radius: 22rpx;
	box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.14);
	text-align: center;
}
.page-title.data-v-1ea813c6 {
	display: block;
	font-size: 40rpx;
	font-weight: 700;
