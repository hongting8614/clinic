<view class="page data-v-6c630261"><view class="page-header data-v-6c630261"><text class="page-title data-v-6c630261">库存报表</text><text class="page-subtitle data-v-6c630261">当前库存结构与风险总览</text></view><view class="filter-card data-v-6c630261"><view class="filter-row location-row data-v-6c630261"><block wx:for="{{locationOptions}}" wx:for-item="opt" wx:for-index="__i0__" wx:key="value"><view data-event-opts="{{[['tap',[['onLocationChange',['$0'],[[['locationOptions','value',opt.value,'value']]]]]]]}}" class="{{['location-tab','data-v-6c630261',(activeLocation===opt.value)?'active':'']}}" bindtap="__e"><text class="location-icon data-v-6c630261">{{opt.icon}}</text><text class="location-text data-v-6c630261">{{opt.label}}</text></view></block></view><view class="filter-row data-v-6c630261"><view class="filter-item keyword-item data-v-6c630261"><text class="label data-v-6c630261">药材筛选</text><view class="search-box data-v-6c630261"><text class="search-icon data-v-6c630261">🔍</text><input class="search-input data-v-6c630261" placeholder="输入药材名称/规格/拼音" confirm-type="search" data-event-opts="{{[['input',[['__set_model',['','keyword','$event',['trim']]]]],['blur',[['$forceUpdate']]]]}}" value="{{keyword}}" bindinput="__e" bindblur="__e"/></view></view></view><view class="filter-row status-row data-v-6c630261"><block wx:for="{{statusOptions}}" wx:for-item="opt" wx:for-index="__i1__" wx:key="value"><view data-event-opts="{{[['tap',[['onStatusChange',['$0'],[[['statusOptions','value',opt.value,'value']]]]]]]}}" class="{{['status-pill','data-v-6c630261',(activeStatus===opt.value)?'active':'']}}" bindtap="__e"><text class="status-text data-v-6c630261">{{opt.label}}</text></view></block></view><view class="filter-row actions-row data-v-6c630261"><view class="action-buttons data-v-6c630261"><button class="btn ghost data-v-6c630261" size="mini" data-event-opts="{{[['tap',[['onReset',['$event']]]]]}}" bindtap="__e">重置</button><button class="btn primary data-v-6c630261" size="mini" data-event-opts="{{[['tap',[['onQuery',['$event']]]]]}}" bindtap="__e">刷新</button><button class="btn export data-v-6c630261" size="mini" data-event-opts="{{[['tap',[['onExport',['$event']]]]]}}" bindtap="__e">导出 ▾</button></view></view></view><view class="summary-section data-v-6c630261"><view class="summary-card data-v-6c630261"><view class="summary-label data-v-6c630261">药材种类</view><text class="summary-value data-v-6c630261">{{summary.totalDrugs}}</text><text class="summary-unit data-v-6c630261">种</text></view><view class="summary-card data-v-6c630261"><view class="summary-label data-v-6c630261">总库存数量</view><text class="summary-value data-v-6c630261">{{summary.totalQuantity}}</text><text class="summary-unit data-v-6c630261">件</text></view><view class="summary-card warning data-v-6c630261"><view class="summary-label data-v-6c630261">库存预警药材</view><text class="summary-value data-v-6c630261">{{summary.warningCount}}</text><text class="summary-unit data-v-6c630261">种</text></view><view class="summary-card danger data-v-6c630261"><view class="summary-label data-v-6c630261">近效期 / 已过期</view><text class="summary-value data-v-6c630261">{{summary.expiryRiskCount}}</text><text class="summary-unit data-v-6c630261">批</text></view></view><view class="table-section data-v-6c630261"><scroll-view class="table-body data-v-6c630261" scroll-y="{{true}}"><block wx:for="{{displayList}}" wx:for-item="item" wx:for-index="index" wx:key="_id"><view class="detail-card data-v-6c630261"><view class="detail-row detail-row-top data-v-6c630261"><view class="detail-main-left data-v-6c630261"><text class="detail-drug data-v-6c630261">{{item.drugName||'-'}}</text><text class="detail-spec data-v-6c630261">{{item.specification||'-'}}</text></view><view class="detail-top-right data-v-6c630261"><block wx:if="{{item.locationName}}"><text class="{{['location-badge','data-v-6c630261','badge-'+(item.location||'all')]}}">{{''+item.locationName+''}}</text></block><text class="detail-no data-v-6c630261">{{"#"+(inde